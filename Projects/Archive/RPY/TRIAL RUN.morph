  <Modules>
    <Module Name="Main" AutoRun="true" SelectedGroupName="Group 1">
      <Groups>
        <Group Name="Group 1">
          <ModelObjects>
            <Table Name="Payments Program Analysis" Left="229" Top="422" Width="485" Height="193" IsMinimized="false" ActiveActionIndex="3">
              <Actions>
                <DeriveTableAction SourceTableName="public.flat_rate_pricing 1" IsConditional="false" />
                <AddColumnsAction ColumnExistsOption="Rename">
                  <Columns>
                    <NameExpressionPair Name="Test_Cal_1">
                      <Expression Value="if([revenue] &gt;[share_of_net_revenue],[total_net_revenue],[total_processing_cost])" Type="Expression" />
                    </NameExpressionPair>
                  </Columns>
                  <InsertPosition Position="AfterColumn" AfterColumnName="revenue_effective_rate" />
                </AddColumnsAction>
                <AddColumnsAction ColumnExistsOption="Rename">
                  <Columns>
                    <NameExpressionPair Name="Test_Cal_2">
                      <Expression Value="(([revenue] +[revenue_effective_rate]) -[payment_partner_cost_effective_rate] +[Test_Cal_1] *[total_card_transactions_per_year]) /100000" Type="Expression" />
                    </NameExpressionPair>
                  </Columns>
                  <InsertPosition Position="AfterColumn" AfterColumnName="total_processing_cost" />
                </AddColumnsAction>
                <AddColumnsAction ColumnExistsOption="Rename">
                  <Columns>
                    <NameExpressionPair Name="Test_Cal_3">
                      <Expression Value="if(([revenue_effective_rate] -[avg_transaction_amount]) *[cost_effective_rate] -[avg_transaction_amount] &gt;= [avg_card_processing_volume_per_mid_per_year] *[payment_partner_cost_effective_rate], [Test_Cal_2]/[Test_Cal_1], [Test_Cal_2]/290000)" Type="Expression" />
                    </NameExpressionPair>
                  </Columns>
                  <InsertPosition Position="AfterColumn" AfterColumnName="cost_effective_rate" />
                </AddColumnsAction>
                <KeepRemoveColumnsAction Mode="Keep">
                  <ColumnNames>
                    <Item>provider</Item>
                    <Item>Test_Cal_1</Item>
                    <Item>Test_Cal_2</Item>
                    <Item>Test_Cal_3</Item>
                  </ColumnNames>
                </KeepRemoveColumnsAction>
                <KeepRemoveColumnsAction Mode="Keep">
                  <ColumnNames>
                    <Item>provider</Item>
                    <Item>Test_Cal_1</Item>
                    <Item>Test_Cal_2</Item>
                    <Item>Test_Cal_3</Item>
                  </ColumnNames>
                </KeepRemoveColumnsAction>
                <ExportExcelAction AutoStatus="true" ExportMode="Create" CreateNamedRange="false" CreateTable="false" FileExistsOption="HaltProjectExecution">
                  <FileName Value="TEST.xlsx" Type="Path" />
                  <WorksheetName Value="Sheet1" Type="Text" />
                </ExportExcelAction>
                <RenameColumnsAction>
                  <Names>
                    <NamePair Name1="Test_Cal_1" Name2="Average Transaction Amount" />
                    <NamePair Name1="Test_Cal_2" Name2="Total Interchange Cost" />
                    <NamePair Name1="Test_Cal_3" Name2="Percentage Per Volume" />
                  </Names>
                </RenameColumnsAction>
                <UnpivotAction>
                  <MetaColumns>
                    <MetaColumn OriginalName="Labels" Width="153" />
