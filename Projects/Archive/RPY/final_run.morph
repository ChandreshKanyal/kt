  <Modules>
    <Module Name="Main" AutoRun="true" SelectedGroupName="Group 1">
      <Groups>
        <Group Name="Group 1">
          <ModelObjects>
            <Table Name="Payments Program Analysis" Left="741" Top="244" Width="512" Height="159" IsMinimized="false" ActiveActionIndex="6">
              <Actions>
                <DeriveTableAction SourceTableName="public.flat_rate_pricing 1" IsConditional="false" />
                <AddColumnsAction ColumnExistsOption="Rename">
                  <Columns>
                    <NameExpressionPair Name="Average Transaction Amount">
                      <Expression Value="if([revenue] &gt;[share_of_net_revenue],[total_net_revenue],[total_processing_cost])" Type="Expression" />
                    </NameExpressionPair>
                  </Columns>
                  <InsertPosition Position="AfterColumn" AfterColumnName="revenue_effective_rate" />
                </AddColumnsAction>
                <AddColumnsAction ColumnExistsOption="Rename">
                  <Columns>
                    <NameExpressionPair Name="Total Interchangable Cost">
                      <Expression Value="(([revenue] +[revenue_effective_rate]) -[payment_partner_cost_effective_rate] +[Average Transaction Amount]*[total_card_transactions_per_year]) /100000" Type="Expression" />
                    </NameExpressionPair>
                  </Columns>
                  <InsertPosition Position="AfterColumn" AfterColumnName="total_processing_cost" />
                </AddColumnsAction>
                <AddColumnsAction ColumnExistsOption="Rename">
                  <Columns>
                    <NameExpressionPair Name="Percentage Per Volume">
                      <Expression Value="if(([revenue_effective_rate] -[avg_transaction_amount]) *[cost_effective_rate] -[avg_transaction_amount] &gt;= [avg_card_processing_volume_per_mid_per_year] *[payment_partner_cost_effective_rate], [Total Interchangable Cost]/[Average Transaction Amount], [Total Interchangable Cost]/290000)" Type="Expression" />
                    </NameExpressionPair>
                  </Columns>
                  <InsertPosition Position="AfterColumn" AfterColumnName="cost_effective_rate" />
                </AddColumnsAction>
                <KeepRemoveColumnsAction Mode="Keep">
                  <ColumnNames>
                    <Item>provider</Item>
                    <Item>Average Transaction Amount</Item>
                    <Item>Total Interchangable Cost</Item>
                    <Item>Percentage Per Volume</Item>
                  </ColumnNames>
                </KeepRemoveColumnsAction>
                <UnpivotAction>
                  <ExceptColumnNames>
                    <Item>provider</Item>
                  </ExceptColumnNames>
                </UnpivotAction>
                <PivotAction LabelsColumnName="provider" DataColumnName="Data" Aggregation="Any" PreserveFormatting="false" />
              </Actions>
              <AnalysisView LayoutMode="Filters" />
            </Table>
